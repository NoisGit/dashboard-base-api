# Environment
ENV=dev
DEBUG=true

# Database URL (legacy )
# If you set this, it has priority over DB_HOST / DB_USER / DB_PASS / DB_NAME
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/sentinel_dev

# Recommended granular DB config
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=sentinel_dev

# Application / JWT secret key
SECRET_KEY=your_secret_key_here

# Firebase service account (BASE64-encoded JSON)
# Paste here the Base64 string of your Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_firebase_key_here
