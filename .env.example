# Coredeck API local development template
ENV=dev
DEBUG=false

# Database
DATABASE_URL=
POSTGRES_USER=coredeck_admin
POSTGRES_PASSWORD=
POSTGRES_DB=coredeck_db
POSTGRES_PORT=5432

# Demo auth
DEMO_EMAIL=admin@nois.dev
DEMO_PASSWORD=

# Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend / CORS
FRONT_URL_BASE=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGO_URL=http://localhost:5173/logo.svg

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=admin@nois.dev
SMTP_PASSWORD=
SMTP_FROM_EMAIL="Coredeck <admin@nois.dev>"

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=coredeck

# pgAdmin local helper
PGADMIN_DEFAULT_EMAIL=admin@nois.dev
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=8080
