# Locentr API local development template
ENV=dev
DEBUG=false

# Database
DATABASE_URL=
POSTGRES_USER=locentr_admin
POSTGRES_PASSWORD=
POSTGRES_DB=locentr_db
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000

# Demo seed
LOCENTR_DEMO_EMAIL=admin@nois.dev
LOCENTR_DEMO_USERNAME=locentr-admin
LOCENTR_DEMO_FULL_NAME=Locentr Admin
LOCENTR_DEMO_CREDENTIAL_HASH=

# Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_REQUEST_BODY_BYTES=10485760
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=100
SLOW_REQUEST_THRESHOLD_MS=1000

# Frontend / CORS
FRONT_URL_BASE=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGO_URL=http://localhost:5173/logo.svg

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=admin@nois.dev
SMTP_PASSWORD=
SMTP_FROM_EMAIL="Locentr <admin@nois.dev>"
EMAIL_DELIVERY_MODE=log
EMAIL_QUEUE_SECRET=
INVITATION_EXPIRE_HOURS=72
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Storage
STORAGE_PUBLIC_BASE_URL=http://localhost:54321/storage/v1/object/public/locentr
STORAGE_BUCKET_NAME=locentr
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
PRIVATE_STORAGE_ROOT=private_storage
STORAGE_SIGNED_URL_EXPIRE_SECONDS=300

# SaaS billing
TRIAL_DAYS=14
TRIAL_PLAN_CODE=growth
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
BILLING_RECONCILIATION_SECRET=

# Supabase compatibility
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
