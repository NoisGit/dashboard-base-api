# Coredeck API local development template
ENV=dev
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://coredeck_admin:coredeck_local_password@localhost:5432/coredeck_db
POSTGRES_USER=coredeck_admin
POSTGRES_PASSWORD=coredeck_local_password
POSTGRES_DB=coredeck_db
POSTGRES_PORT=5432

# Auth
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend / CORS
FRONT_URL_BASE=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGO_URL=http://localhost:5173/logo.svg

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL="Coredeck <notifications@example.com>"

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=coredecklocal
AZURE_STORAGE_CONNECTION_STRING=replace-with-azure-connection-string

# pgAdmin local helper
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
PGADMIN_PORT=8080
