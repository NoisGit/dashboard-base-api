# Environment
ENV=dev
DEBUG=true

# Option 1 (recommended in this project): full connection string
# Takes precedence over DB_HOST / DB_USER / DB_PASS / DB_NAME
DATABASE_URL=postgresql+asyncpg://porteria_admin:mi_password_secreto@localhost:5432/porteria_db

# Option 2 (granular config) – used only if DATABASE_URL is not set
DB_HOST=localhost
DB_USER=porteria_admin
DB_PASS=mi_password_secreto
DB_NAME=porteria_db

# Secret key for JWT / security
SECRET_KEY=change_this_secret_key

# Firebase – Base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_service_account_here
